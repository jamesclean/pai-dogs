# Postgres connection string (Supabase, Neon, or local)
DATABASE_URL=postgres://dogs:dogs@localhost:5432/paidogs

# Public address of the site. This goes into every QR code, so pick it before engraving tags.
SITE_URL=https://paidogs.org

# Password volunteers use at /admin/login, and a long random string for signing sessions
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Shown on public pages
PROGRAM_NAME="Pai Dogs"
CONTACT_LINE=
CONTACT_PHONE=

# Optional: Telegram alerts when someone reports a dog
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
